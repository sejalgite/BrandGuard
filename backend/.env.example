# BrandGuard Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="BrandGuard API"

# Database Configuration (PostgreSQL 18 + pgvector)
DATABASE_URL=postgresql://brandguard_user:brandguard_secure_password@localhost:5435/brandguard
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT & Security
SECRET_KEY=brandguard_development_secret_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional AI Providers (Zero-Budget Free Tiers / Local)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

